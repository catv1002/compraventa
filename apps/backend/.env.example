# PostgreSQL (Railway lo provee automáticamente como DATABASE_URL en producción)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/compraventa?schema=public"

# JWT
# Genéralo con: openssl rand -base64 48 — la app NO arranca con este valor de ejemplo
JWT_SECRET="change-me-in-production"
JWT_ACCESS_TOKEN_TTL="8h"
JWT_REFRESH_TOKEN_TTL="7d"

# Cloudflare R2 (S3-compatible) — para fotos de artículos y documentos
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="compraventa-items"
R2_ENDPOINT=""

# App
PORT=3100
CORS_ORIGIN="http://localhost:5173"

# Desarrollo local: omite la verificación del código MFA en el login.
# Solo surte efecto si NODE_ENV != production. Nunca ponerla en un servidor real.
MFA_BYPASS=false
